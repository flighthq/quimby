{
  "name": "quimby",
  "version": "0.2.0",
  "description": "Orchestrate multiple AI agents working on a single project in isolated environments — local or remote",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "agents",
    "ai",
    "claude",
    "cli",
    "orchestration",
    "sandbox",
    "tmux"
  ],
  "homepage": "https://github.com/flighthq/quimby#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flighthq/quimby.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/flighthq/quimby/issues"
  },
  "bin": {
    "quimby": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "check": "eslint src",
    "clean": "rm -rf dist",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@quimbyhq/errors": "*",
    "@quimbyhq/git": "*",
    "@quimbyhq/handoff": "*",
    "@quimbyhq/layout": "*",
    "@quimbyhq/launch": "*",
    "@quimbyhq/paths": "*",
    "@quimbyhq/pool": "*",
    "@quimbyhq/reporter": "*",
    "@quimbyhq/runtime-profile": "*",
    "@quimbyhq/runtimes": "*",
    "@quimbyhq/server": "*",
    "@quimbyhq/session": "*",
    "@quimbyhq/status": "*",
    "@quimbyhq/template": "*",
    "@quimbyhq/transport": "*",
    "@quimbyhq/types": "*",
    "@quimbyhq/utils": "*",
    "@quimbyhq/agent": "*",
    "@quimbyhq/workspace": "*",
    "citty": "^0.1.6",
    "consola": "^3.4.2",
    "execa": "^9.6.1",
    "pathe": "^2.0.3",
    "yaml": "^2.7.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^3.2.6",
    "tsup": "*",
    "typescript": "*",
    "vitest": "^3.2.3"
  }
}
